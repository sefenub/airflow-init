# Docker setup
# https://docs.docker.com/desktop/enterprise/allow-list/
#
# Copy to .env, fill in, and `chmod 600 .env`. Never commit .env.
#
# Avoid `$` in values: compose treats it as variable interpolation.

# Image reference printed by `make image` after `make build`.
AIRFLOW_IMAGE_NAME=

# Encrypts secrets in postgres. Any secrets not from env or
# external source will be lost on rotation.
# Generate with:
#   python3 -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW_FERNET_KEY=

# Host user that should own dags/, logs/ and files written to DATA_DIR. Use `id -u`.
AIRFLOW_UID=

# Generate each with: openssl rand -hex 32
POSTGRES_PASSWORD=
AIRFLOW__API__SECRET_KEY=
AIRFLOW__API_AUTH__JWT_SECRET=

# Admin login for the UI. Only applied when the user is first created.
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=

# Public HTTPS URL served by the proxy, no trailing slash or path. Must match
# server_name in proxy/airflow.conf and the certificate's SAN.
AIRFLOW_BASE_URL=https://airflow.client.example

# DAG repo pulled into dags/ by git-sync. Must be public over HTTPS, or see
# the git-sync docs for GITSYNC_USERNAME / GITSYNC_PASSWORD_FILE / SSH keys.
GIT_SYNC_REPO=

# Optional overrides (defaults shown).
# GIT_SYNC_REF=main
# GIT_SYNC_PERIOD=60s
# AIRFLOW_PARALLELISM=8
# AIRFLOW_BIND=127.0.0.1
# AIRFLOW_PORT=8080
# DATA_DIR=./data
# POSTGRES_DATA_DIR=./pgdata
